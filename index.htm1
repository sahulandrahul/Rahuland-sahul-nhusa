<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rahul & Sahul - Bhusa Order</title>
<meta name="description" content="Rahul & Sahul bhusa ordering service for Kabre, Bhaktapur and Kathmandu.">

<style>
body{font-family:Arial,sans-serif;margin:0;background:#f5f1e8;color:#222}
header{background:#5b3a1e;color:white;text-align:center;padding:28px 15px}
header h1{margin:0;font-size:34px}
header p{margin:8px 0 0}
.container{max-width:650px;margin:25px auto;padding:20px}
.card{background:white;padding:22px;border-radius:14px;box-shadow:0 3px 12px #0002}
h2{color:#5b3a1e}
label{display:block;margin-top:14px;font-weight:bold}
input,select,textarea{width:100%;box-sizing:border-box;padding:12px;margin-top:6px;border:1px solid #ccc;border-radius:8px;font-size:16px}
button{width:100%;margin-top:20px;padding:14px;background:#2f7d32;color:white;border:0;border-radius:8px;font-size:17px;font-weight:bold;cursor:pointer}
.info{background:#fff7dc;padding:14px;border-radius:8px;margin-bottom:18px}
footer{text-align:center;padding:20px;color:#666}
</style>
</head>

<body>

<header>
<h1>Rahul & Sahul</h1>
<p>🌾 Bhusa Order Service</p>
</header>

<div class="container">
<div class="card">

<div class="info">
🌾 Fresh bhusa available. Price is set by the admin per bora.
Delivery: Kabre, Bhaktapur, Kathmandu.
</div>

<h2>Order Bhusa</h2>

<label>Bhusa Type</label>
<select id="type">
<option>Wheat Bhusa</option>
<option>Rice Bhusa</option>
<option>Other Bhusa</option>
</select>

<label>Number of Bora</label>
<input id="quantity" type="number" min="1" step="1" placeholder="Example: 5 bora">

<label>Delivery Area</label>
<select id="area">
<option>Kabre</option>
<option>Bhaktapur</option>
<option>Kathmandu</option>
</select>

<label>Your Name</label>
<input id="name" type="text" placeholder="Enter your name">

<label>Phone Number</label>
<input id="phone" type="tel" placeholder="Enter phone number">

<label>Delivery Address</label>
<textarea id="address" rows="3" placeholder="Enter delivery address"></textarea>

<label>Extra Note</label>
<textarea id="note" rows="2" placeholder="Any special request"></textarea>

<button onclick="placeOrder()">Order on WhatsApp</button>

</div>
</div>

<div class="container">
<div class="card">

<h2>Admin Price Control</h2>

<div class="info">
Set the selling price per bora on this device.
</div>

<label>Admin Password</label>
<input id="adminPassword" type="password" placeholder="Enter admin password">

<label>Price per Bora (NPR)</label>
<input id="price" type="number" min="0" step="1" placeholder="Example: 500">

<button onclick="savePrice()">Save Price</button>

<p id="priceStatus"></p>

</div>
</div>

<footer>
© 2026 Rahul & Sahul • Bhusa Order Service
</footer>

<script>

function placeOrder(){

const type=document.getElementById('type').value;
const quantity=document.getElementById('quantity').value;
const area=document.getElementById('area').value;
const name=document.getElementById('name').value;
const phone=document.getElementById('phone').value;
const address=document.getElementById('address').value;
const note=document.getElementById('note').value;

if(!quantity || !name || !phone || !address){
alert("Please fill all required details.");
return;
}

const savedPrice=Number(localStorage.getItem("bhusaPrice")||0);
const total=savedPrice*Number(quantity);

const message =
"New Bhusa Order - Rahul & Sahul\n\n"+
"Bhusa: "+type+"\n"+
"Quantity: "+quantity+" bora\n"+
"Delivery Area: "+area+"\n"+
"Price per Bora: NPR "+savedPrice+"\n"+
"Estimated Total: NPR "+total+"\n"+
"Name: "+name+"\n"+
"Phone: "+phone+"\n"+
"Address: "+address+"\n"+
"Note: "+note;

const whatsappUrl =
"https://wa.me/9779816842321?text="+encodeURIComponent(message);

window.open(whatsappUrl,"_blank");

setTimeout(function(){
window.location.href=whatsappUrl;
},300);

}

function savePrice(){

const password=document.getElementById('adminPassword').value;
const price=document.getElementById('price').value;

if(password!=="rahul123"){
alert("Incorrect admin password.");
return;
}

if(price==="" || Number(price)<0){
alert("Enter a valid price per bora.");
return;
}

localStorage.setItem("bhusaPrice",price);

document.getElementById('priceStatus').textContent =
"Price saved: NPR "+price+" per bora.";

document.getElementById('adminPassword').value="";

}

</script>

</body>
</html>
